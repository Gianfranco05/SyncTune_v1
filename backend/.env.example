# --- Spotify (https://developer.spotify.com/dashboard) ---
# IMPORTANT (Feb 2026 Spotify Web API changes, see IMPLEMENTATION_PLAN.md):
#   - The Spotify account that owns this app must have an active Premium
#     subscription, or the API calls will fail even in Development Mode.
#   - Development Mode apps are capped at 5 users. Add every Spotify account
#     that will test this app to the app's allowlist in the dashboard
#     (App Settings -> User Management).
#   - Redirect URI to register in the dashboard:
#       http://127.0.0.1:8000/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback

# --- YouTube Data API v3 (https://console.cloud.google.com) ---
YOUTUBE_API_KEY=

# Signs the session cookie AND encrypts OAuth tokens at rest. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Frontend origin, for CORS and post-login redirect.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# --- PostgreSQL ---
# Matches the docker-compose.yml `postgres` service at the repo root.
# Run `docker compose up -d postgres` before starting the backend.
# NOTE: host port 5434, not 5432 — this avoids clashing with a native
# PostgreSQL service that may already be running on this machine.
DATABASE_URL=postgresql+psycopg2://synctune:synctune@localhost:5434/synctune

# --- Google OAuth (https://console.cloud.google.com) ---
# Optional: only needed to use "Conectar YouTube". The rest of the app
# (Spotify + video lookup via YOUTUBE_API_KEY) works fine without it.
#   1. APIs & Services -> OAuth consent screen -> External -> Testing.
#      Add every Google account that will test this (up to 100).
#   2. APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#      -> Web application.
#   3. Authorized redirect URI:
#        http://127.0.0.1:8000/api/youtube/callback
#   NOTE: while the app is unverified (Testing status, the only option for a
#   personal project — see docs/EVOLUTION_PLAN.md §3), Google expires
#   refresh tokens after 7 days. Reconnecting is a known, accepted limitation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/callback
