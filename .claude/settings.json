{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Bash(*)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "mcp__*__*delete*",
      "mcp__*__*send_email*",
      "mcp__*__*send_message*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*secret*)",
      "Read(./**/*credentials*)"
    ]
  }
}
