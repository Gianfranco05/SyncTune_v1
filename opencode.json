{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*secret*": "deny",
      "*credentials*": "deny"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git diff *": "allow",
      "git status": "allow",
      "go build *": "allow",
      "go test *": "allow",
      "rm -rf": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git push * --force*": "ask",
      "git push * -f*": "ask",
      "git reset --hard*": "ask",
      "sudo": "ask",
      "sudo *": "ask",
      "curl": "ask",
      "curl *": "ask",
      "wget": "ask",
      "wget *": "ask",
      "*.env*": "ask",
      "*secret*": "ask",
      "*credentials*": "ask",
      "rm -rf *": "deny",
      "rm -rf /*": "deny"
    },
    "webfetch": "ask",
    "external_directory": "ask",
    "*_*delete*": "ask",
    "*_*send_email*": "ask",
    "*_*send_message*": "ask"
  }
}
